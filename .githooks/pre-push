#!/bin/sh
# This checkout may write only to its owner's fork. The collaborator stays read-only.
case "$2" in
  https://github.com/Jc-augenstern/rine-webui-ixd|https://github.com/Jc-augenstern/rine-webui-ixd.git|git@github.com:Jc-augenstern/rine-webui-ixd.git) ;;
  *) echo "Push blocked: only Jc-augenstern/rine-webui-ixd is writable from this checkout." >&2; exit 1 ;;
esac
if [ "$1" != "origin" ]; then
  echo "Push blocked: use origin, never upstream." >&2
  exit 1
fi
