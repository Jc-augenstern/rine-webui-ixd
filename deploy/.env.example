# Copy to a protected local file; never commit real values.
# Generate independent URL-safe random values. Empty values fail closed in Compose.
POSTGRES_ADMIN_PASSWORD=
POSTGRES_APP_PASSWORD=
SESSION_SECRET=
PG_HOST_PORT=5433
# Production only. A domain and existing TLS certificate files are required.
IXD_DOMAIN=
TLS_DIRECTORY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Keep loopback during local configuration review; change only for an approved server deployment.
HTTP_BIND=127.0.0.1
HTTPS_BIND=127.0.0.1
