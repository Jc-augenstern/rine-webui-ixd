{
  "name": "@ixd/server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server/src/index.js",
    "migrate": "tsx src/cli.ts migrate",
    "seed:dev": "tsx src/cli.ts seed-dev",
    "admin:init": "tsx src/cli.ts admin-init",
    "admin:recover": "tsx src/cli.ts admin-recover",
    "content:import": "tsx src/cli.ts content-import",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/csrf-protection": "8.0.1",
    "@fastify/multipart": "10.1.2",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/session": "11.1.3",
    "argon2": "0.45.1",
    "fastify": "5.12.5",
    "file-type": "22.1.1",
    "luxon": "3.7.2",
    "marked": "18.0.14",
    "nodemailer": "10.0.10",
    "pg": "8.23.0",
    "sanitize-html": "2.17.7",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^7.0.0",
    "@types/pg": "^8.15.0",
    "@types/sanitize-html": "^2.16.0",
    "tsx": "4.23.15"
  }
}
