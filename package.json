{
  "name": "rhine-lab-analysis-os",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "workspaces": ["server", "admin"],
  "scripts": {
    "postinstall": "node scripts/patch-rolling-number.mjs",
    "predev": "node scripts/patch-rolling-number.mjs && node scripts/export-records.mjs",
    "dev": "vite --host 127.0.0.1",
    "prebuild": "node scripts/patch-rolling-number.mjs && node scripts/export-records.mjs && node scripts/prepare-webfonts.mjs",
    "check:content": "node --experimental-strip-types --test scripts/check-content.mjs",
    "check:auth": "node --experimental-strip-types --test scripts/check-ixd-auth.mjs",
    "check:palette": "node --experimental-strip-types scripts/check-palette.mjs",
    "check:viewport": "node --experimental-strip-types scripts/check-viewport.mjs",
    "review:mobile": "node scripts/serve-mobile-review.mjs",
    "export:archives": "node scripts/export-records.mjs",
    "build": "tsc && vite build && node scripts/build-pwa.mjs",
    "build:cloudflare": "npm run build && node scripts/package-cloudflare.mjs",
    "build:wallpaper": "node scripts/patch-rolling-number.mjs && node scripts/export-records.mjs && tsc && vite build --mode wallpaper --outDir release/wallpaper && node scripts/build-wallpaper.mjs",
    "format": "prettier --write src scripts index.html package.json tsconfig.json",
    "preview": "vite preview --host 127.0.0.1",
    "dev:api": "npm run dev --workspace @ixd/server",
    "dev:admin": "npm run dev --workspace @ixd/admin",
    "build:api": "npm run build --workspace @ixd/server",
    "build:admin": "npm run build --workspace @ixd/admin",
    "build:all": "npm run build && npm run build:api && npm run build:admin",
    "db:migrate": "npm run migrate --workspace @ixd/server",
    "db:seed": "npm run seed:dev --workspace @ixd/server",
    "admin:init": "npm run admin:init --workspace @ixd/server --",
    "test:platform": "npm run test --workspace @ixd/server",
    "check:cache": "node --test scripts/check-platform-cache.mjs",
    "env:check": "node scripts/platform-check.mjs",
    "env:setup": "node scripts/platform-runtime.mjs setup",
    "platform:start": "node scripts/platform-services.mjs start",
    "platform:stop": "node scripts/platform-services.mjs stop",
    "platform:status": "node scripts/platform-services.mjs status",
    "backup:local": "node scripts/platform-backup.mjs backup",
    "restore:local": "node scripts/platform-backup.mjs restore",
    "admin:recover": "npm run admin:recover --workspace @ixd/server --",
    "content:import": "npm run content:import --workspace @ixd/server --"
  },
  "dependencies": {
    "@kitlangton/rolling-number": "0.4.1",
    "three": "^0.183.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/three": "^0.183.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  }
}
